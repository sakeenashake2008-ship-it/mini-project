# SkillMatch AI - Industry Skill & Curriculum Alignment Platform
# Environment Configuration

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://localhost:27017/skillmatch_ai
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillmatch_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillmatch_ai

# Google Gemini API Key for AI-Powered Recommendations & Learning Roadmaps
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

